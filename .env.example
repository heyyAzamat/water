# ===================================================================
# AquaVision AI — environment
#
# Every variable here is OPTIONAL. With none of them set the platform boots
# into demo mode: the bundled dataset backs every read, and uploads are scored
# by the built-in colourimetric engine. Add keys to switch each subsystem to
# production one at a time.
# ===================================================================

# -------------------------------------------------------------------
# Supabase — database, auth and object storage
# Without these: demo dataset + synthetic demo user, nothing persists.
# Project settings → API
# -------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS so AI scores cannot be forged from a browser.
# NEVER expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for uploaded photographs. Created by migration 0002.
SUPABASE_STORAGE_BUCKET=water-uploads

# -------------------------------------------------------------------
# Vision AI — Google Gemini
# Without this: the colourimetric heuristic engine analyses uploads and
# results are labelled "Heuristic engine" in the UI.
# Get a key at https://aistudio.google.com/apikey
# -------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
VISION_MODEL=gemini-2.5-flash
VISION_TIMEOUT_MS=45000

# -------------------------------------------------------------------
# Deployment
# -------------------------------------------------------------------
# Absolute origin, used for OAuth redirects and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Radius for "new report nearby" alerts and the nearby-assessments panel.
NEARBY_RADIUS_KM=25
